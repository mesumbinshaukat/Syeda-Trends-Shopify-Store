{% doc %}
  @prompt
    Generate an outstanding footer, and use these color combination in footer:
    - Dark Red
    - White
    
    I want at least 3 column based footer, one column for logo, second column for quick links, and third column for social handles, and I want copyright message in a different separate row, don't want in these columns.
    
    Footer should be big and breathable, should have some cool effect and small animations around social icons. And if logo is not uploaded then consider text as logo until logo is uploaded. Make sure footer is very impressive and enticing. Make sure layout is 100% responsive and userfriendly. 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.footer_bg_color }};
    color: {{ block.settings.footer_text_color }};
    padding: {{ block.settings.footer_padding_top }}px 0 0;
    width: 100%;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-footer-main-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.column_gap }}px;
    padding-bottom: {{ block.settings.main_padding_bottom }}px;
    border-bottom: 1px solid {{ block.settings.footer_text_color | color_modify: 'alpha', 0.2 }};
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.column_content_gap }}px;
  }

  .ai-footer-logo-wrapper-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-footer-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-footer-logo-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.logo_text_size }}px;
    font-weight: 700;
    color: {{ block.settings.footer_text_color }};
    letter-spacing: 1px;
  }

  .ai-footer-tagline-{{ ai_gen_id }} {
    font-size: {{ block.settings.tagline_size }}px;
    line-height: 1.6;
    color: {{ block.settings.footer_text_color | color_modify: 'alpha', 0.8 }};
  }

  .ai-footer-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.footer_text_color }};
    margin-bottom: 8px;
    letter-spacing: 0.5px;
  }

  .ai-footer-links-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ai-footer-link-{{ ai_gen_id }} {
    color: {{ block.settings.footer_text_color | color_modify: 'alpha', 0.8 }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    transition: all 0.3s ease;
    display: inline-block;
  }

  .ai-footer-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.footer_text_color }};
    transform: translateX(5px);
  }

  .ai-footer-social-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.social_gap }}px;
    flex-wrap: wrap;
  }

  .ai-footer-social-link-{{ ai_gen_id }} {
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.social_bg_color }};
    color: {{ block.settings.social_icon_color }};
    border-radius: {{ block.settings.social_border_radius }}px;
    text-decoration: none;
    transition: all 0.4s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    position: relative;
    overflow: hidden;
  }

  .ai-footer-social-link-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    border-radius: 50%;
    background-color: {{ block.settings.social_hover_bg }};
    transform: translate(-50%, -50%);
    transition: width 0.4s ease, height 0.4s ease;
    z-index: 0;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover::before {
    width: 100%;
    height: 100%;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover {
    transform: translateY(-5px) scale(1.1);
    box-shadow: 0 8px 20px {{ block.settings.social_hover_bg | color_modify: 'alpha', 0.4 }};
  }

  .ai-footer-social-link-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.social_icon_size }}px * 0.5);
    height: calc({{ block.settings.social_icon_size }}px * 0.5);
    position: relative;
    z-index: 1;
    transition: color 0.3s ease;
  }

  .ai-footer-social-link-{{ ai_gen_id }}:hover svg {
    color: {{ block.settings.social_hover_icon_color }};
  }

  .ai-footer-copyright-{{ ai_gen_id }} {
    padding: {{ block.settings.copyright_padding }}px 0;
    text-align: center;
  }

  .ai-footer-copyright-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.copyright_size }}px;
    color: {{ block.settings.footer_text_color | color_modify: 'alpha', 0.7 }};
  }

  @media screen and (max-width: 989px) {
    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 40px;
    }

    .ai-footer-column-{{ ai_gen_id }}:first-child {
      grid-column: 1 / -1;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-footer-{{ ai_gen_id }} {
      padding: {{ block.settings.footer_padding_top | times: 0.7 }}px 0 0;
    }

    .ai-footer-main-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-bottom: {{ block.settings.main_padding_bottom | times: 0.7 }}px;
    }

    .ai-footer-column-{{ ai_gen_id }}:first-child {
      grid-column: 1;
    }

    .ai-footer-logo-{{ ai_gen_id }} img {
      max-width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-footer-social-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-footer-copyright-{{ ai_gen_id }} {
      padding: {{ block.settings.copyright_padding | times: 0.7 }}px 0;
    }
  }
{% endstyle %}

<footer-block-{{ ai_gen_id }} class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-container-{{ ai_gen_id }}">
    <div class="ai-footer-main-{{ ai_gen_id }}">
      <div class="ai-footer-column-{{ ai_gen_id }}">
        <div class="ai-footer-logo-wrapper-{{ ai_gen_id }}">
          {% if block.settings.logo %}
            <div class="ai-footer-logo-{{ ai_gen_id }}">
              <img
                src="{{ block.settings.logo | image_url: width: 400 }}"
                alt="{{ shop.name }}"
                loading="lazy"
                width="{{ block.settings.logo.width }}"
                height="{{ block.settings.logo.height }}"
              >
            </div>
          {% else %}
            <div class="ai-footer-logo-text-{{ ai_gen_id }}">
              {{ block.settings.logo_text | default: shop.name }}
            </div>
          {% endif %}
          {% if block.settings.tagline != blank %}
            <div class="ai-footer-tagline-{{ ai_gen_id }}">
              {{ block.settings.tagline }}
            </div>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.quick_links_heading != blank %}
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.quick_links_heading }}</h3>
        {% endif %}
        <div class="ai-footer-links-{{ ai_gen_id }}">
          {% if block.settings.link_1_text != blank and block.settings.link_1_url != blank %}
            <a href="{{ block.settings.link_1_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_1_text }}
            </a>
          {% endif %}
          {% if block.settings.link_2_text != blank and block.settings.link_2_url != blank %}
            <a href="{{ block.settings.link_2_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_2_text }}
            </a>
          {% endif %}
          {% if block.settings.link_3_text != blank and block.settings.link_3_url != blank %}
            <a href="{{ block.settings.link_3_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_3_text }}
            </a>
          {% endif %}
          {% if block.settings.link_4_text != blank and block.settings.link_4_url != blank %}
            <a href="{{ block.settings.link_4_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_4_text }}
            </a>
          {% endif %}
          {% if block.settings.link_5_text != blank and block.settings.link_5_url != blank %}
            <a href="{{ block.settings.link_5_url }}" class="ai-footer-link-{{ ai_gen_id }}">
              {{ block.settings.link_5_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-footer-column-{{ ai_gen_id }}">
        {% if block.settings.social_heading != blank %}
          <h3 class="ai-footer-heading-{{ ai_gen_id }}">{{ block.settings.social_heading }}</h3>
        {% endif %}
        <div class="ai-footer-social-{{ ai_gen_id }}">
          {% if block.settings.facebook_url != blank %}
            <a
              href="{{ block.settings.facebook_url }}"
              class="ai-footer-social-link-{{ ai_gen_id }}"
              aria-label="Facebook"
              target="_blank"
              rel="noopener"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
          {% endif %}
          {% if block.settings.instagram_url != blank %}
